# Generated by scripts/docker.py; edit docker/nginx/Dockerfile.in.
# Reuse the exact application version for its validated nginx apply helper.
ARG REPOWATCH_IMAGE=repowatch:local
FROM ${REPOWATCH_IMAGE}
USER 0:10001
# nginx and its matching Debian modules are container-only dependencies.
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 755 /usr/sbin/policy-rc.d \
    && apt-get update && apt-get install -y --no-install-recommends \
        nginx libnginx-mod-http-js libnginx-mod-http-cache-purge \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/nginx/repowatch /etc/nginx/conf.d /var/cache/nginx/repowatch \
    && chmod 755 /etc/nginx/repowatch \
    && chown www-data:www-data /var/cache/nginx/repowatch \
    && ln -sf /etc/nginx/repowatch/active.conf /etc/nginx/conf.d/repowatch.conf \
    && ln -sf /dev/stdout /var/log/nginx/repo-cache.access.log
COPY nginx.conf /etc/nginx/nginx.conf
COPY policy.json /etc/nginx/repowatch/policy.json
COPY run.py /usr/local/lib/repowatch-nginx.py
VOLUME ["/var/cache/nginx/repowatch"]
EXPOSE 8080
ENTRYPOINT ["tini", "--", "python", "/usr/local/lib/repowatch-nginx.py"]
CMD []
